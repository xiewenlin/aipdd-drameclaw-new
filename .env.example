# SuperTale / NovelVideo newAPI 环境变量示例
#
# 复制�?.env 后填写真实值�?
# SuperTale 侧只配置 newAPI 网关、newAPI 逻辑模型名、参考媒�?relay 和运行环境参数�?
# 上游渠道、真实模型、映射、价格和 token 权限�?newAPI 后台配置�?


# =============================================================================
# 1. newAPI 统一网关
# =============================================================================

# NewAPI 地址、API Key、模型同步与功能绑定统一在网页“设�?�?模型配置”完成�?
# 配置写入全局 settings.db，所有项目共享，不支持项目或请求级覆盖�?
# 官方服务外链：https://newapi.aipdd.work

NEWAPI_TEXT_TIMEOUT_SECONDS=120
# NEWAPI_TEXT_TRUST_ENV=false
# OFFICIAL_MODEL_SERVICE_URL=https://newapi.chonghuayunke.com

# =============================================================================
# 2. newAPI 参考媒�?OSS relay
# =============================================================================

# 本地参考图需要先上传�?OSS relay，再把短期签�?URL 传给 newAPI/上游�?
# CE 前端保存 OSS relay 配置后，本地 SQLite 配置优先生效�?
MEDIA_RELAY_PROVIDER=aliyun_oss

# 签名 URL 默认有效期，单位秒。CE 前端保存后，本地 SQLite 配置优先生效�?
MEDIA_RELAY_TTL_SECONDS=1800

# relay bucket 固定�?newAPI 参考媒体使用。CE 前端保存后，本地 SQLite 配置优先生效�?
OSS_RELAY_ENDPOINT=oss-cn-chengdu.aliyuncs.com
OSS_RELAY_BUCKET=claymore-llm-relay
OSS_RELAY_AK=
OSS_RELAY_SK=

# 可选：使用 Cloudinary 作为参考媒�?relay。将 MEDIA_RELAY_PROVIDER 设为 cloudinary 后生效�?
CLOUDINARY_RELAY_CLOUD_NAME=
CLOUDINARY_RELAY_API_KEY=
CLOUDINARY_RELAY_API_SECRET=
CLOUDINARY_RELAY_FOLDER=


# =============================================================================
# 3. Cognee 知识图谱
# =============================================================================

# Cognee 模型由全局功能绑定选择；历史项目模型字段不参与运行时选模�?
COGNEE_SKIP_CONNECTION_TEST=true
COGNEE_LLM_CONCURRENCY=2
COGNEE_EMBEDDING_BATCH_CONCURRENCY=4
EMBEDDING_BATCH_SIZE=10

# =============================================================================
# 4. newAPI 文本模型
# =============================================================================

# 文本、视觉、图片、视频、音频和 Embedding 均在设置页按功能绑定�?
# MODEL_NAME�?_MODEL、Provider Key 和独�?Base URL 不参与运行时选择�?

# =============================================================================
# 6. 图像基础参数
# =============================================================================

IMAGE_DEFAULT_WIDTH=1440
IMAGE_DEFAULT_HEIGHT=2560
IMAGE_DEFAULT_STYLE=chinese_period_drama


# =============================================================================
# 7. newAPI 视频模型
# =============================================================================

# 视频与音频模型由设置页全局功能绑定选择�?
NEWAPI_VIDEO_RESOLUTION=720p
NEWAPI_VIDEO_GENERATE_AUDIO=auto
INDEXTTS2_TIMEOUT_SECONDS=1800

# =============================================================================
# 9. 视频基础参数
# =============================================================================

VIDEO_FPS=30
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_CODEC=libx264
VIDEO_AUDIO_CODEC=aac
VIDEO_BITRATE=4M


# =============================================================================
# 10. UI 配置
# =============================================================================


# BuilderGPT Director viewer 对浏览器可访问的地址�?
# 局域网协作时改为本�?LAN IP，例�?http://192.168.2.206:9024�?
DIRECTOR_VIEWER_URL=http://127.0.0.1:9024

# operator 操作口令：护「导出提示词」与「图像生成防护闸」�?
# 必须设为你自己的非默认值；留空 = 这些受护动作一律拒�?无公开默认口令)�?
PROMPT_EXPORT_PASSWORD=change_me

# 版本/功能更新通知。false = 完全关闭 release feed,不读包内 notes、不访问 GitHub�?
RELEASE_NOTIFICATIONS_ENABLED=true

# 可�?GitHub token,用于提高 GitHub releases/latest 查询限流额度；留空走匿名请求�?
RELEASE_NOTIFICATIONS_GITHUB_TOKEN=


# =============================================================================
# 11. 输出目录
# =============================================================================

NOVELVIDEO_OUTPUT_DIR=output

# =============================================================================
# Database (PostgreSQL)
# =============================================================================

# PostgreSQL connection - used for multi-user auth and per-user settings
DB_PASSWORD=dramaclaw_dev
DB_PORT=5432

# Encryption key for sensitive fields (api keys, secrets). Must be at least 32 chars.
# IMPORTANT: Change this in production and keep it secret!
DB_ENCRYPTION_KEY=dev_encryption_key_change_in_production_32b