{
  "name": "gulong-short-drama-desktop",
  "version": "1.0.0",
  "description": "古龙短剧生产站 Windows 桌面客户端",
  "author": "古龙 Gulong Agent Engine",
  "private": true,
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "build:win": "npm test && electron-builder --win nsis portable --x64"
  },
  "devDependencies": {
    "electron": "43.4.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.sologle.shortdrama",
    "productName": "古龙短剧",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "renderer/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "icon": "assets/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "Gulong-ShortDrama-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "古龙短剧"
    },
    "portable": {
      "artifactName": "Gulong-ShortDrama-Portable-${version}-${arch}.${ext}"
    }
  }
}
